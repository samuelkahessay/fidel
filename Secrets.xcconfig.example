// Secrets.xcconfig.example
// For local development with a hardcoded key:
//   1. Edit Secrets.xcconfig directly with your API key
//   2. Don't commit your changes to Secrets.xcconfig
//
// For CI/CD (Xcode Cloud):
//   Set OPENROUTER_API_KEY as an environment variable
//   The Secrets.xcconfig uses $(OPENROUTER_API_KEY:default=) to pick it up

// Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY = your-api-key-here
