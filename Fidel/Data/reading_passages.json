  {
    "id": "rp-3",
    "title": "A Visit to Addis Ababa",
    "cefr": "B1",
    "sentences": [
      {
        "amharic": "ባለፈው ሳምንት ወደ አዲስ አበባ ሄድኩ።",
        "transliteration": "balefew samint wede addis abeba hedku.",
        "english": "Last week I went to Addis Ababa."
      },
      {
        "amharic": "አዲስ አበባ የኢትዮጵያ ዋና ከተማ ናት።",
        "transliteration": "addis abeba ye-ityop'ya wana ketema nat.",
        "english": "Addis Ababa is the capital city of Ethiopia."
      },
      {
        "amharic": "በመጀመሪያ ቀን ብዙ ሰዎችን አየሁ።",
        "transliteration": "bemejemeriya qen bizu sewochin ayehu.",
        "english": "On the first day I saw many people."
      },
      {
        "amharic": "ከተማዋ በጣም ትልቅ እና ውብ ናት።",
        "transliteration": "ketemawa bet'am tiliq ina wib nat.",
        "english": "The city is very big and beautiful."
      },
      {
        "amharic": "እኔ እና ጓደኛዬ ወደ ገበያ ሄድን እና ስጦታ ገዛን።",
        "transliteration": "ine ina gwadenyaye wede gebeya hedin ina sit'ota gezan.",
        "english": "My friend and I went to the market and bought a gift."
      },
      {
        "amharic": "ምሽት ላይ በአንድ ምግብ ቤት ጣፋጭ እንጀራ በላን።",
        "transliteration": "mishit lay be-and migib bet t'afach' injera belan.",
        "english": "In the evening we ate delicious injera at a restaurant."
      },
      {
        "amharic": "ጉዞዬ በጣም ጥሩ ነበር።",
        "transliteration": "guzoye bet'am t'iru neber.",
        "english": "My trip was very good."
      },
      {
        "amharic": "በሚቀጥለው ዓመት እንደገና መሄድ እፈልጋለሁ።",
        "transliteration": "bemiqet'ilew amet indegena mehed ifeligalehu.",
        "english": "Next year I want to go again."
      }
