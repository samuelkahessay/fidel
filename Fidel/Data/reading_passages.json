  {
    "id": "rp-1",
    "title": "My Daily Routine (የቀኔ ተግባር)",
    "cefr": "A2",
    "sentences": [
      {
        "amharic": "እኔ በጠዋት እነሳለሁ።",
        "transliteration": "ine bet'ewat inesalehu.",
        "english": "I get up in the morning."
      },
      {
        "amharic": "ፊቴን እታጠባለሁ።",
        "transliteration": "fiten itat'ebalehu.",
        "english": "I wash my face."
      },
      {
        "amharic": "ቁርስ እበላለሁ።",
        "transliteration": "k'urs ibelalehu.",
        "english": "I eat breakfast."
      },
      {
        "amharic": "ወደ ስራ እሄዳለሁ።",
        "transliteration": "wede sira ihedalehu.",
        "english": "I go to work."
      },
      {
        "amharic": "ከሰዓት በኋላ ወደ ቤት እመለሳለሁ።",
        "transliteration": "kese'at behwala wede bet imelesalehu.",
        "english": "In the afternoon I return home."
      },
      {
        "amharic": "ማታ እራት እበላለሁ።",
        "transliteration": "mata irat ibelalehu.",
        "english": "In the evening I eat dinner."
      },
      {
        "amharic": "ከዚያ በኋላ መጽሐፍ አነባለሁ።",
        "transliteration": "keziya behwala mets'haf anebalehu.",
        "english": "After that I read a book."
      },
      {
        "amharic": "በሌሊት እተኛለሁ።",
        "transliteration": "belelit iten'yalehu.",
        "english": "At night I sleep."
      }
