  {
    "id": "rp-2",
    "title": "A Trip to the Market (ወደ ገበያ ጉዞ)",
    "cefr": "A2",
    "sentences": [
      {
        "amharic": "ዛሬ ወደ ገበያ እሄዳለሁ።",
        "transliteration": "zare wede gebeya ihedalehu.",
        "english": "Today I go to the market."
      },
      {
        "amharic": "ገበያው በጣም ትልቅ ነው።",
        "transliteration": "gebeyaw bet'am tiliq new.",
        "english": "The market is very big."
      },
      {
        "amharic": "በገበያው ብዙ ሰዎች አሉ።",
        "transliteration": "be-gebeyaw bizu sewoch alu.",
        "english": "There are many people in the market."
      },
      {
        "amharic": "ዳቦ፣ ወተትና ፍራፍሬ እፈልጋለሁ።",
        "transliteration": "dabo, wetetna firafre ifeligalehu.",
        "english": "I want bread, milk, and fruit."
      },
      {
        "amharic": "\"ሙዝ ስንት ነው?\" እጠይቃለሁ።",
        "transliteration": "\"muz sint new?\" it'eyiqalehu.",
        "english": "\"How much is a banana?\" I ask."
      },
      {
        "amharic": "ነጋዴው \"ሃያ ብር ነው\" ይላል።",
        "transliteration": "negadew \"haya bir new\" yilal.",
        "english": "The merchant says, \"It is twenty birr.\""
      },
      {
        "amharic": "ገንዘቡን እከፍላለሁ።",
        "transliteration": "genzebun ikeflalehu.",
        "english": "I pay the money."
      },
      {
        "amharic": "ገበያው በጣም ደስ ይለኛል።",
        "transliteration": "gebeyaw bet'am des yilenyal.",
        "english": "I really like the market."
      }
    ],
