  {
    "id": "rp-5",
    "title": "የሥራ ቀን (A Day at Work)",
    "cefr": "B1",
    "sentences": [
      {
        "amharic": "እኔ በአንድ ኩባንያ ውስጥ እሰራለሁ።",
        "transliteration": "ine beand kubaniya wist' iseralehu.",
        "english": "I work at a company."
      },
      {
        "amharic": "በየቀኑ ጠዋት ወደ ሥራ በአውቶቡስ እሄዳለሁ።",
        "transliteration": "beyeqenu t'ewat wede sira beawtobus ihedalehu.",
        "english": "Every morning I go to work by bus."
      },
      {
        "amharic": "ቢሮ ስደርስ መጀመሪያ ኢሜል አነባለሁ።",
        "transliteration": "biro siders mejemeriya imel anebalehu.",
        "english": "When I arrive at the office, first I read email."
      },
      {
        "amharic": "ከባልደረቦቼ ጋር በስብሰባ ላይ እወያያለሁ።",
        "transliteration": "kebaldereboche gar besibseba lay iweyayalehu.",
        "english": "I discuss things with my colleagues in a meeting."
      },
      {
        "amharic": "ቀትር ላይ ከጓደኞቼ ጋር ምሳ እበላለሁ።",
        "transliteration": "qetir lay kegwadegnoche gar misa ibelalehu.",
        "english": "At noon I eat lunch with my friends."
      },
      {
        "amharic": "ከሰዓት በኋላ ብዙ ሥራ አለ፣ ስለዚህ በጣም እደክማለሁ።",
        "transliteration": "kesat behuala bizu sira ale, silezih bet'am idekmalehu.",
        "english": "In the afternoon there is a lot of work, so I get very tired."
      },
      {
        "amharic": "ሥራ ሲያልቅ ወደ ቤት ተመልሼ አርፋለሁ።",
        "transliteration": "sira siyalq wede bet temelshe arfalehu.",
        "english": "When work ends, I return home and rest."
      }
