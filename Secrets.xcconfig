// Secrets.xcconfig
// API keys and secrets configuration
// For local development: Replace placeholder values with your actual keys
// For CI/CD (Xcode Cloud): Set environment variables for each key

// OpenRouter API Key - https://openrouter.ai/keys
OPENROUTER_API_KEY = $(OPENROUTER_API_KEY:default=)

// ElevenLabs API Key - https://elevenlabs.io/
ELEVENLABS_API_KEY = $(ELEVENLABS_API_KEY:default=)
